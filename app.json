{
  "expo": {
    "name": "الأفق",
    "slug": "horizon-calendar-v2",
    "version": "0.2.9",
    "orientation": "portrait",
    "scheme": "horizoncalendar",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horizon.calendar",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لحساب مواقيت الصلاة ورؤية الهلال محلياً.",
        "NSUserNotificationUsageDescription": "نستخدم الإشعارات لتذكيرك بالصلاة والمناسبات."
      }
    },
    "android": {
      "package": "com.horizon.calendar",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 11
    },
    "plugins": [
      "expo-location",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/adhan/beautiful-adhan.ogg",
            "./assets/adhan/adhan-syria-sabah-fakhry.ogg",
            "./assets/adhan/adhan-morocco-hassan-ii.ogg",
            "./assets/adhan/adhan-kazakhstan-shalqar.ogg",
            "./assets/adhan/adhan-aaqib-azeez.ogg"
          ]
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "524b2de5-2dd1-4be8-b073-9a87fa6137b7"
      }
    }
  }
}
